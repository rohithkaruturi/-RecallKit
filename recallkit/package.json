{
  "name": "recallkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-powered Study Assistant - Converts notes into flashcards and quizzes using Groq LLMs",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "study",
    "flashcards",
    "quiz",
    "ai",
    "groq"
  ],
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "jsdom": "^29.1.1",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
